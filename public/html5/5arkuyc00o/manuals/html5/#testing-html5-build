(function() {
	function enhanceImageLoading(img) {
		if (!img || img.nodeType !== 1) {
			return;
		}
		if (!img.hasAttribute("loading")) {
			var className = img.getAttribute("class") || "";
			var eager = /\b(page-hero-graphic|frontpage-hero-logo-image|topnav-brand-image)\b/.test(className);
			img.setAttribute("loading", eager ? "eager" : "lazy");
		}
		if (!img.hasAttribute("decoding")) {
			img.setAttribute("decoding", "async");
		}
	}

	function scanImages(root) {
		var images = root.getElementsByTagName ? root.getElementsByTagName("img") : [];
		for (var index = 0; index < images.length; index += 1) {
			enhanceImageLoading(images[index]);
		}
	}

	if ("MutationObserver" in window) {
		new MutationObserver(function(mutations) {
			for (var index = 0; index < mutations.length; index += 1) {
				var nodes = mutations[index].addedNodes;
				for (var nodeIndex = 0; nodeIndex < nodes.length; nodeIndex += 1) {
					var node = nodes[nodeIndex];
					if (node.nodeType !== 1) {
